# Скопируйте в .env или запустите: tg setup
# api_id/api_hash: https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Личный аккаунт
TG_PHONE=+79991234567
TG_MODE=user

# Либо бот (тогда TG_MODE=bot и укажите токен)
TG_BOT_TOKEN=

# Файл сессии (Telethon добавит .session)
TG_SESSION=data/telegram

# Куда скачивать файлы
TG_DOWNLOAD_DIR=downloads

# Необязательно: пароль 2FA для неинтерактивного входа.
# Хранить пароль в открытом виде небезопасно.
TG_PASSWORD=
